# ============================================================
# Vantage — Environment Variable Reference
# ============================================================
# This file documents ALL environment variables used by the
# platform. Copy to .env and fill in values for local dev.
# Never commit real secrets. Use Doppler for staging/prod.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://vantage:vantage@localhost:5432/vantage
DATABASE_MAX_CONNECTIONS=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (MinIO in dev, Cloudflare R2 in prod) ─────
R2_ENDPOINT=http://localhost:9000
R2_BUCKET_RESUMES=vantage-resumes-dev
R2_BUCKET_EXPORTS=vantage-exports-dev
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PUBLIC_URL=http://localhost:9000

# ── AWS KMS ──────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID_OAUTH_TOKENS=

# ── Auth ─────────────────────────────────────────────────────
AUTH_SECRET=change-me-min-32-chars-random-string
BETTER_AUTH_URL=http://localhost:3001

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── AI Providers ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Payments ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_ID_PREMIUM_ANNUAL=price_...

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@vantage.app

# ── Feature Flags ────────────────────────────────────────────
STATSIG_SERVER_SDK_KEY=
STATSIG_CLIENT_SDK_KEY=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=

# ── Automation (Phase 3) ─────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
