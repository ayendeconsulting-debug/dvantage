{
  "name": "@vantage/worker-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Vantage AI worker — resume parsing, extraction, optimization, and scoring",
  "scripts": {
    "dev":       "nodemon",
    "build":     "tsc",
    "start":     "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint":      "eslint src/",
    "clean":     "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk":    "^0.39.0",
    "@aws-sdk/client-s3":  "^3.1045.0",
    "@nestjs/common":       "^10.0.0",
    "@nestjs/core":         "^11.1.18",
    "@vantage/ai":          "workspace:*",
    "@vantage/config":      "workspace:*",
    "@vantage/database":    "workspace:*",
    "@vantage/events":      "workspace:*",
    "@vantage/parsing":     "workspace:*",
    "@vantage/queue":       "workspace:*",
    "@vantage/validation":  "workspace:*",
    "bullmq":               "^5.0.0",
    "dotenv":               "^16.0.0",
    "drizzle-orm":          "^0.45.0",
    "ioredis":              "^5.3.0",
    "reflect-metadata":     "^0.2.0",
    "rxjs":                 "^7.8.0"
  },
  "devDependencies": {
    "@swc/core":          "^1.4.0",
    "@types/node":        "^20.0.0",
    "nodemon":            "^3.0.0",
    "rimraf":             "^6.0.0",
    "ts-node":            "^10.9.0",
    "tsconfig-paths":     "^4.2.0",
    "typescript":         "^5.5.0"
  }
}
