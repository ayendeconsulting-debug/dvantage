{
  "name": "vantage",
  "version": "0.0.1",
  "private": true,
  "description": "Vantage â€” AI-powered career operating system",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "dev:docker:up": "docker compose up -d",
    "dev:docker:down": "docker compose down",
    "dev:docker:reset": "docker compose down -v --remove-orphans && docker compose up -d",
    "dev:docker:logs": "docker compose logs -f",
    "dev:setup": "powershell -ExecutionPolicy Bypass -File scripts/dev-setup.ps1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {}
}
